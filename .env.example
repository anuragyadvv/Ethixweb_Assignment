# ==============================================================================
# ETHIXWEB INDIA - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your Supabase credentials:
# cp .env.example .env.local
# ==============================================================================

# Supabase Project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER ONLY - Never expose to client)
# Used exclusively by Next.js server route handlers to safely insert leads bypassing anon locks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Base URL of the website
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Admin Email Filter (Comma-separated list of emails allowed to manage leads)
# If left empty, any authenticated user created in Supabase Auth can access the admin dashboard.
ADMIN_ALLOWED_EMAILS=admin@ethixweb.com
